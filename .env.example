# ---------------------------------------------------------------------------
# cdc-infrastructure - environment
# Copy to .env and adjust. NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Shared Docker network (must be created once, see README) ---------------
MIGRATION_NETWORK=migration-network

# --- Kafka ----------------------------------------------------------------
# Host port used only for inspection from the host machine (kafka-console-*).
KAFKA_HOST_PORT=9092
# Fixed KRaft cluster id. Keep it stable so the data volume stays valid across
# restarts. Generate a new one with:  docker run --rm apache/kafka:3.9.1 \
#   /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=5Yr1SIgYQz-b-dgRabWx4g

# --- Kafka Connect / Debezium -------------------------------------------
CONNECT_HOST_PORT=8083
CONNECT_GROUP_ID=cdc-connect-cluster

# --- Legacy PostgreSQL (the monolith database = source of truth) ---------
# Hostname is the DNS name of the legacy Postgres container *inside* the
# shared Docker network (see the network alias in the monolith compose patch).
LEGACY_PG_HOST=legacy-postgres
LEGACY_PG_PORT=5432
LEGACY_PG_DBNAME=monolith

# Dedicated replication user created in postgres/enable-cdc.sql
LEGACY_PG_DEBEZIUM_USER=debezium
LEGACY_PG_DEBEZIUM_PASSWORD=change-me-debezium

# Superuser, only used by scripts to run one-off inspection SQL.
LEGACY_PG_ADMIN_USER=postgres
LEGACY_PG_ADMIN_PASSWORD=postgres

# --- Debezium connector identity (KEEP STABLE) ---------------------------
CONNECTOR_NAME=legacy-cdc-connector
TOPIC_PREFIX=legacy
PUBLICATION_NAME=legacy_cdc_publication
REPLICATION_SLOT_NAME=legacy_cdc_slot

# Legacy Postgres container name (for `docker exec` from the scripts).
LEGACY_PG_CONTAINER=monolito-microservice-postgres-1
